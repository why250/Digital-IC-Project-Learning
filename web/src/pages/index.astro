---
import Base from '../layouts/Base.astro';
import { courses, lessons } from '../lib/catalog';
const route = [
  { title: '同步 RTL / SPI', range: '01–06', href: '/learn/course/01_sync_spi/' },
  { title: '综合与 STA', range: '07–10', href: '/learn/course/02_synth_sta/' },
  { title: 'CDC / 原子配置', range: '11–24', href: '/learn/course/03_slave_cdc/' },
  { title: '测量与校准控制', range: '25–44', href: '/learn/mixed_signal/00_course/' },
  { title: 'ΔΣ 抽取滤波', range: 'DF01–DF08', href: '/learn/delta_sigma_filter/00_course/' },
  { title: 'TI-ADC 后端', range: 'AD01–AD20', href: '/learn/adc_digital/00_course/' },
];
---
<Base title="从模拟直觉，走进数字设计">
  <section class="hero"><div class="hero-inner">
    <div class="hero-copy"><p class="eyebrow">Analog intuition → digital design</p><h1>从模拟直觉，<br />走进数字设计。</h1><p class="hero-description">每一段 RTL，都能画成寄存器和门。<br />从一帧 SPI 开始，连接时序、控制、校准与数据处理。</p><div class="actions"><a class="button primary" href="/learn/course/01_sync_spi/">开始第一课 <span aria-hidden="true">→</span></a><a class="button" href="/plan/">查看我的学习路线</a></div><div class="hero-stats"><span><b>{lessons.length}</b> 节课程</span><span><b>6</b> 个方向</span><span><b>1</b> 个清晰起点</span></div></div>
    <div class="circuit-card"><div class="circuit-caption"><span class="eyebrow">One clock. Predictable state.</span><span class="tag">Lesson 01</span></div><svg viewBox="0 0 440 280" role="img" aria-label="一个系统时钟驱动两个寄存器，中间是组合逻辑；下方时序展示时钟上升沿更新 Q。"><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="currentColor"/></marker></defs><g class="wires" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M76 84h36m68 0h48m72 0h35" marker-end="url(#arrow)"/><path d="M65 141H364M144 141v-24M335 141v-24"/><path d="M43 197h20v-24h30v24h30v-24h30v24h30v-24h30v24h30v-24h30v24h30v-24h30v24h30v-24h30v24h23"/><path class="q-wave" d="M43 237h80v-24h120v24h167"/></g><rect x="112" y="47" width="68" height="70" rx="4"/><rect x="228" y="57" width="72" height="51" rx="4"/><rect x="335" y="47" width="68" height="70" rx="4"/><g class="circuit-text"><text x="147" y="88" text-anchor="middle">Q</text><text x="264" y="78" text-anchor="middle">组合</text><text x="264" y="97" text-anchor="middle">逻辑</text><text x="369" y="88" text-anchor="middle">D → Q</text><text x="44" y="88">输入</text><text x="30" y="145">clk</text><text x="12" y="191">clk</text><text x="17" y="231">Q</text></g><g class="edge-lines"><path d="M123 161v86M243 161v86"/></g><text x="225" y="269" class="bottom-label" text-anchor="middle">同一边沿读旧 Q，边沿后得到新状态</text></svg><div class="circuit-footer"><span>寄存器</span><span>门与负载</span><span>采样窗口</span><span>PVT</span></div></div>
  </div></section>
  <div class="wrap home-content">
    <div class="section-head"><h2>一条主线，逐步扩展</h2><a class="small" href="/learn/roadmap/">阅读完整路线与前置 →</a></div>
    <nav class="route-steps" aria-label="推荐学习顺序">{route.map(item => <a class="route-step" href={item.href}><span>{item.range}</span><strong>{item.title}</strong></a>)}</nav>
    <p class="small muted">DF 数学可与基础课并行；完成公共基础后优先做自己的抽取项目。AMS 随项目加入，DAC 后续选学。</p>
    <div class="section-head"><h2>课程与实验</h2><p>个人验收独立于工具 PASS · <a href="/plan/">记录我的进度</a></p></div>
    <div class="course-grid">{courses.map(course => <article class="course-card"><div class="card-top"><span class="course-number">{course.icon} / {course.label}</span><span class="course-hours">{course.hours}</span></div><h3><a href={`/learn/${course.id}/00_course/`}>{course.title} <span aria-hidden="true">↗</span></a></h3><p>{course.summary}</p><div class="card-foot"><span data-course-progress={course.id}>0 / {course.last - course.first + 1} 已验收</span><a href={`/courses/?course=${course.id}`}>讲义、答案与项目 →</a></div></article>)}</div>
    <div class="start-grid"><a class="callout" href="/lab/spi/"><p class="eyebrow">Try / Lesson 01</p><h3>一帧 A5 / 3C，逐沿看清楚</h3><p class="small muted">改分频、选择采样沿，把移位寄存器和 SCLK 的关系连起来。</p></a><div class="callout"><p class="eyebrow">Evidence / Engineering</p><h3>先看已有证据，再决定运行什么</h3><p class="small muted"><a href="/learn/progress/">当前验证范围</a> · <a href="/learn/running/">运行指南</a><br />SPI 与 ADC 已有独立回归，其他项目按课程实现。</p></div></div>
  </div>
</Base>
<style>
.hero{border-bottom:1px solid var(--rule);position:relative;overflow:hidden}.hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(var(--rule) 1px,transparent 1px),linear-gradient(90deg,var(--rule) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(90deg,transparent 25%,#000);opacity:.3;pointer-events:none}.hero-inner{max-width:1180px;margin:auto;padding:68px 32px 54px;display:grid;grid-template-columns:1.05fr 1fr;gap:64px;align-items:center;position:relative}.hero h1{font-size:clamp(35px,4.7vw,55px);line-height:1.35;margin:16px 0 20px}.hero-description{color:var(--muted);font-size:14px;line-height:1.9;margin-bottom:28px}.hero-stats{display:flex;gap:28px;margin-top:30px;font-size:11px;color:var(--muted)}.hero-stats b{font:18px var(--mono);margin-right:5px;color:var(--ink)}.circuit-card{padding:22px;background:var(--paper);border:1px solid var(--rule);border-radius:8px;box-shadow:0 15px 55px #17212e08}.circuit-caption{display:flex;justify-content:space-between;gap:8px;align-items:center}.circuit-caption .eyebrow{font-size:9px;letter-spacing:.07em}.circuit-card svg{display:block;width:100%;margin:15px 0}.circuit-card rect{fill:var(--brand-soft);stroke:var(--brand);stroke-width:1.3}.wires{color:var(--muted)}.q-wave{stroke:var(--brand);stroke-width:2}.circuit-text{fill:var(--ink);font:12px var(--mono)}.edge-lines{stroke:var(--blue);stroke-dasharray:3 4;opacity:.4}.bottom-label{fill:var(--muted);font:11px var(--sans)}.circuit-footer{border-top:1px solid var(--rule);padding-top:14px;display:flex;justify-content:space-between;gap:8px;font-size:10px;color:var(--muted)}.home-content{padding-top:8px}.start-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:42px}.start-grid>a{color:var(--ink);text-decoration:none}.start-grid>a:hover{border-color:var(--brand)}
@media(max-width:900px){.hero-inner{gap:28px;padding-top:48px}.circuit-card{padding:16px}}@media(max-width:760px){.hero-inner{padding:38px 20px;grid-template-columns:1fr;gap:30px}.hero h1{font-size:36px}.hero-stats{gap:20px}.circuit-card{max-width:460px}.start-grid{grid-template-columns:1fr}.circuit-card svg{max-height:235px}.hero-description br{display:none}}
</style>
