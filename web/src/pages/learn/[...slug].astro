---
import Base from '../../layouts/Base.astro';
import LearningRecord from '../../components/LearningRecord.astro';
import { courses, documents, lessons, renderDocument, type Document } from '../../lib/catalog';
export function getStaticPaths() { return documents.map(doc => ({ params: { slug: doc.slug }, props: { doc } })); }
interface Props { doc: Document }
const { doc } = Astro.props;
const html = renderDocument(doc);
const siblings = documents.filter(item => item.courseId === doc.courseId && item.courseId);
const position = siblings.findIndex(item => item.file === doc.file);
const previous = siblings[position - 1];
const next = siblings[position + 1];
const currentLessons = lessons.filter(lesson => lesson.file === doc.file);
---
<Base title={doc.title}>
  <div class="reader"><aside class="sidebar" aria-label="课程导航"><p class="eyebrow">Learning library</p><a href="/plan/">我的路线与记录</a><a href="/courses/">搜索全部材料</a>{courses.map(course => <details open={doc.courseId === course.id}><summary>{course.title}</summary>{documents.filter(item => item.courseId === course.id).map(item => <a href={item.url} aria-current={item.file === doc.file ? 'page' : undefined}>{item.title}</a>)}</details>)}<details open={!doc.courseId}><summary>路线与工程参考</summary>{documents.filter(item => !item.courseId).map(item => <a href={item.url} aria-current={item.file === doc.file ? 'page' : undefined}>{item.title}</a>)}</details></aside>
    <div class="reader-content"><div class="reader-toolbar"><a href={doc.courseId ? `/courses/?course=${doc.courseId}` : '/courses/'}>← 课程目录</a><span>{doc.kind}</span><a href={`/raw/${doc.file}`} download={doc.file.split('/').pop()}>下载 Markdown ↓</a></div><article class="prose" set:html={html} />
      {currentLessons.length > 0 && <section class="reader-records" aria-label="本讲学习记录"><h2>先写预测，再留下自己的解释</h2><p>本讲包含 {currentLessons.length} 课。展开对应课程，保存个人状态和笔记。</p><LearningRecord items={currentLessons} compact /></section>}
      {(previous || next) && <nav class="page-pagination" aria-label="前后材料"><div>{previous && <a href={previous.url}>← {previous.title}</a>}</div><div>{next && <a href={next.url}>{next.title} →</a>}</div></nav>}
    </div><aside class="toc" aria-label="本页目录"><p class="eyebrow">On this page</p>{doc.headings.filter(heading => heading.depth === 2 || heading.depth === 3).map(heading => <a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>)}<a href="/plan/">我的学习记录 →</a></aside>
  </div>
</Base>
