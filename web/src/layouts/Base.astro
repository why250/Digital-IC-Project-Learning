---
import '../styles/global.css';
import { lessons, classroomURL, repositoryURL } from '../lib/catalog';
interface Props { title: string; description?: string }
const { title, description = '面向模拟 IC 工程师的数字与数模混合设计课程：从同步 RTL 到控制、校准、抽取滤波与 AMS。' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Digital IC Classroom</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f8fa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script is:inline>
      try { if (localStorage.getItem('digital-ic-theme') === 'dark') document.documentElement.classList.add('dark'); } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/" aria-label="Digital IC Classroom 首页"><img src="/favicon.svg" width="28" height="28" alt="" /><span>Digital IC <b>Classroom</b></span></a>
        <nav aria-label="主导航">
          <a href="/plan/" aria-current={Astro.url.pathname === '/plan/' ? 'page' : undefined}>学习路线</a>
          <a href="/courses/" aria-current={Astro.url.pathname === '/courses/' ? 'page' : undefined}>课程目录</a>
          <a href="/lab/spi/" aria-current={Astro.url.pathname === '/lab/spi/' ? 'page' : undefined}>SPI 实验</a>
          <a class="sibling-link" href={classroomURL}>模拟课堂 ↗</a>
          <button class="theme-button" type="button" id="theme-toggle" aria-label="切换明暗主题">◐</button>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer"><div><span>Digital IC Classroom · 从电路理解数字设计</span><a href={classroomURL}>Circuits &amp; Systems ↗</a><a href={repositoryURL}>项目源码 ↗</a></div><p>学习记录保存在当前浏览器，可导出备份。教学模型与综合结果的适用范围见 <a href="/learn/progress/">验证证据</a>。</p></footer>
    <p id="notice" class="notice" role="status" aria-live="polite"></p>
    <script id="lesson-index" type="application/json" set:html={JSON.stringify(lessons.map(({ id, title, courseId }) => ({ id, title, courseId })))} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
